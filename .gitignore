# Built Unity player, third-party libraries and local backups stay local.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/PLAYING.md
!/AGENTS.md
!/llms.txt
!/demo-manifest.json
!/codemeta.json
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/Refinement/
!/scripts/
!/docs/
!/assets/
!/.github/
/Refinement/*/
**/bin/
**/obj/
*.user
*.log
*.dll
*.exe
*.zip
*.nupkg
__pycache__/
